\@writefile{toc}{\contentsline {section}{\numberline {A.7}Model Interpretation}{23}{appendix.G}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S13}{\ignorespaces Relative selection scores (RSS) with respect to environmental covariates. RSS scores were computed by comparing a location $x_1$ with average conditions to a location $x_2$ with average conditions but the respective covariate varied between its minimum and maximum observed value. Confidence intervals overlapped substantially, hence we omitted them from the figure to simplify with the interpretation of the differences among configurations.}}{23}{figure.caption.25}\protected@file@percent }
\newlabel{MovementModelInterpretation}{{S13}{23}{Relative selection scores (RSS) with respect to environmental covariates. RSS scores were computed by comparing a location $x_1$ with average conditions to a location $x_2$ with average conditions but the respective covariate varied between its minimum and maximum observed value. Confidence intervals overlapped substantially, hence we omitted them from the figure to simplify with the interpretation of the differences among configurations}{figure.caption.25}{}}
\newlabel{MovementModelInterpretation@cref}{{[figure][13][2147483647]S13}{[1][23][]23}}
\@writefile{toc}{\contentsline {section}{\numberline {A.8}Spearman's Rank Correlation in Relation to the Number of Random Steps}{24}{appendix.H}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S14}{\ignorespaces Illustration how the Spearman's rank correlation changes when the number of random steps per stratum is varied from 5 to 100 (facettes). The y-axis shows the frequency at which the observed step was assigned the rank indicated on the x-axis. A low rank indicates that the observed step was assigned a high probability of being chosen. The better the prediction, the more frequently the observed step should be assigned a low rank, thus resulting in negative Spearman's rank-correlation. However, it is obvious that the metric heavily depends on the number of random steps per stratum. If there are only a few random steps, the correlation is more likely to be negative. The show patterns are based on simulated data.}}{24}{figure.caption.26}\protected@file@percent }
\newlabel{RankCorrelationNumberSteps}{{S14}{24}{Illustration how the Spearman's rank correlation changes when the number of random steps per stratum is varied from 5 to 100 (facettes). The y-axis shows the frequency at which the observed step was assigned the rank indicated on the x-axis. A low rank indicates that the observed step was assigned a high probability of being chosen. The better the prediction, the more frequently the observed step should be assigned a low rank, thus resulting in negative Spearman's rank-correlation. However, it is obvious that the metric heavily depends on the number of random steps per stratum. If there are only a few random steps, the correlation is more likely to be negative. The show patterns are based on simulated data}{figure.caption.26}{}}
\newlabel{RankCorrelationNumberSteps@cref}{{[figure][14][2147483647]S14}{[1][24][]24}}
