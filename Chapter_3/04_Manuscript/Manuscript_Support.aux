\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces To reduce the number of Sentinel 2 tiles that we needed to download, we generated a monthly updated spatio-temporal moving window that comprised all GPS data of dispersing wild dogs (black dots) during the respective month, buffered by a 100 km radius. Based on the so created moving windows (in blue), we identified all overlapping Sentinel 2 tiles (tiles in gray) that we needed to download each month, which resulted in a total of 2,226 tiles.}}{16}{figure.caption.14}\protected@file@percent }
\newlabel{MovingWindows}{{S10}{16}{To reduce the number of Sentinel 2 tiles that we needed to download, we generated a monthly updated spatio-temporal moving window that comprised all GPS data of dispersing wild dogs (black dots) during the respective month, buffered by a 100 km radius. Based on the so created moving windows (in blue), we identified all overlapping Sentinel 2 tiles (tiles in gray) that we needed to download each month, which resulted in a total of 2,226 tiles}{figure.caption.14}{}}
\newlabel{MovingWindows@cref}{{[figure][10][2147483647]S10}{[1][16][]16}}
