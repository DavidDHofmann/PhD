      \field{issn}{1432-0762}
      \field{journaltitle}{Behavioral Ecology and Sociobiology}
      \field{langid}{english}
      \field{month}{2}
      \field{number}{2}
      \field{shortjournal}{Behav Ecol Sociobiol}
      \field{title}{Biologically {{Meaningful Moonlight Measures}} and {{Their Application}} in {{Ecological Research}}}
